{
  "name": "shawarma-basel-pos",
  "version": "1.0.0",
  "description": "Electron Offline-First Shawarma Restaurant POS",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build-icon": "node scripts/build-icon.js",
    "build:template-db": "node scripts/build-template-db.js",
    "reset-db": "node scripts/reset-db.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build": "electron-packager . \"Shawarma Basel POS\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icons/app-icon.ico --ignore=\"^dist[0-9]\" --prune=true",
    "build:dist2": "electron-packager . \"Shawarma Basel POS\" --platform=win32 --arch=x64 --out=dist2 --overwrite --icon=assets/icons/app-icon.ico --ignore=\"^dist[0-9]\" --prune=true",
    "build:dist3": "electron-packager . \"Shawarma Basel POS\" --platform=win32 --arch=x64 --out=dist3 --overwrite --icon=assets/icons/app-icon.ico --ignore=\"^dist[0-9]\" --prune=true",
    "build:dist5": "electron-packager . \"Shawarma Basel POS\" --platform=win32 --arch=x64 --out=dist5 --overwrite --icon=assets/icons/app-icon.ico --ignore=\"^dist[0-9]\" --prune=false"
  },
  "keywords": [
    "electron",
    "pos",
    "shawarma",
    "offline-first"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.shawarmabasel.pos",
    "productName": "Shawarma Basel POS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/db/",
        "to": "assets/db/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.4.0",
    "electron-packager": "^17.1.2",
    "electron-rebuild": "^3.2.9",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.33.5",
    "sql.js": "^1.14.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0"
  }
}
